# Copy to .env and adjust as needed.

# "production" marks the guest_id cookie as Secure (HTTPS only).
ENV=development

# Must match the Postgres service in the root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/audio_notes

# Cloudflare R2 (Dashboard → R2 → Manage API tokens; needs Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upload limits.
MAX_UPLOAD_BYTES=2147483648
# Unfinished uploads with no activity for this long are aborted and marked failed.
UPLOAD_STALE_HOURS=24

# Gnani speech-to-text (https://app.gnani.ai → API keys).
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MODEL=gnani-prisma-v2.5
# Audio up to this many seconds uses Gnani's synchronous endpoint (it rejects over 30 s); longer uses batch.
SYNC_MAX_SECONDS=25

# Gnani's batch-completion webhook. PUBLIC_API_URL is the API's public base URL that Gnani can reach
# (e.g. https://<app>.vercel.app/api). Leave it empty locally: results are then collected by polling.
PUBLIC_API_URL=
# Random string used to sign webhook URLs, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
