# Copy to .env and adjust as needed.

# "production" marks the guest_id cookie as Secure (HTTPS only).
ENV=development

# Leave unset to use the Postgres from the root docker-compose.yml (localhost:5432 locally, the `db`
# container under `docker compose --profile app`). Set it to use another database, e.g. Supabase:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Cloudflare R2 (Dashboard → R2 → Manage API tokens; needs Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upload limits.
MAX_UPLOAD_BYTES=2147483648
# Unfinished uploads with no activity for this long are aborted and marked failed.
UPLOAD_STALE_HOURS=24

# Gnani speech-to-text (https://app.gnani.ai → API keys).
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MODEL=gnani-prisma-v2.5
# Audio up to this many seconds uses Gnani's synchronous endpoint (it rejects over 30 s); longer uses batch.
SYNC_MAX_SECONDS=25

# Gnani's batch-completion webhook. PUBLIC_API_URL is the API's public base URL that Gnani can reach
# (e.g. https://<app>.vercel.app/api). Leave it empty locally: results are then collected by polling.
PUBLIC_API_URL=
# Random string used to sign webhook URLs, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# Summaries: any OpenAI-compatible Chat Completions API. Set the base URL, key and a model it offers:
#   OpenAI      https://api.openai.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   Anthropic   https://api.anthropic.com/v1/
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (no key needed)
#   AWS Bedrock https://bedrock-runtime.<region>.amazonaws.com/openai/v1   (Bedrock API key; model e.g. deepseek.v3-v1:0)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# true sends response_format={"type":"json_object"}; only if your provider/model supports it.
LLM_JSON_MODE=false
LLM_TIMEOUT_SECONDS=90
# Transcripts longer than this many characters are summarized in parts, then combined.
LLM_CHUNK_CHARS=24000
